API_PORT=8000
EVIDENCE_DEFAULT_STUDY_ID=drug_shortage_eis
EVIDENCE_DEFAULT_PROFILE_ID=baseline

# Optional runtime overrides. Empty values keep the selected profile's settings.
EVIDENCE_MIN_YEAR=2021
EVIDENCE_MAX_YEAR=2026
EVIDENCE_SEARCH_LANGUAGE=en
EVIDENCE_INCLUDE_ABSTRACTS=true
EVIDENCE_ENRICH_ABSTRACTS=true

# Optional per-source overrides. Use true or false; empty keeps protocol.yaml.
EVIDENCE_SOURCE_PUBMED_ENABLED=true
EVIDENCE_SOURCE_PUBMED_REQUIRED=true
EVIDENCE_SOURCE_OPENALEX_ENABLED=true
EVIDENCE_SOURCE_OPENALEX_REQUIRED=true
EVIDENCE_SOURCE_CROSSREF_ENABLED=true
EVIDENCE_SOURCE_CROSSREF_REQUIRED=true
EVIDENCE_SOURCE_SCOPUS_ENABLED=true
EVIDENCE_SOURCE_SCOPUS_REQUIRED=true
EVIDENCE_SOURCE_SCIENCEDIRECT_ENABLED=true
EVIDENCE_SOURCE_SCIENCEDIRECT_REQUIRED=true
EVIDENCE_SOURCE_SEMANTIC_SCHOLAR_ENABLED=false
EVIDENCE_SOURCE_SEMANTIC_SCHOLAR_REQUIRED=false

RESEARCH_CONTACT_EMAIL=researcher@example.org
OPENALEX_API_KEY=
NCBI_API_KEY=
# Scopus: STANDARD needs fewer metadata entitlements; COMPLETE is optional.
SCOPUS_SEARCH_VIEW=STANDARD
ELSEVIER_INSTTOKEN=
ELSEVIER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

API_PORT=8000
EVIDENCE_DEFAULT_STUDY_ID=drug_shortage_eis

# Required for API identification.
RESEARCH_CONTACT_EMAIL=name@example.com

# Required only for a new OpenAlex search. Not needed to replay a checkpoint.
OPENALEX_API_KEY=

# Optional. Raises the PubMed E-utilities limit from 3 to 10 requests/second.
NCBI_API_KEY=

# Optional. Leave blank to skip sources that require these keys.
ELSEVIER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
